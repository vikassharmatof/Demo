<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="ButtonStyle" parent="Widget.MaterialComponents.Button">
        <item name="android:background">@drawable/button_shape</item> <!-- Use the shape drawable -->
        <item name="backgroundTint">@null</item> <!-- Prevents backgroundTint from overriding the drawable -->
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:minHeight">20dp</item> <!-- Set the minimum height -->
        <item name="textAllCaps">false</item>
    </style>

    <style name="TextStyle">
        <item name="android:textSize">20dp</item>
        <item name="android:textStyle">italic</item>
    </style>


</resources>

